<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log In</title>
    <link rel="stylesheet" href="/shared.css" />
    <link rel="stylesheet" href="/pages/login/style.css" />
    <script src="/pages/login/main.js" defer></script>
  </head>
  <body>
    <div id="root" class="login__page-wrapper justify-center min-h-screen py-4">
      <div class="max-w-lg mx-auto w-full flex flex-col gap-8">
        <header
          class="flex border rounded-lg border-gray-300 gap-8 items-center"
        >
          <div class="size-20">
            <img
              class="w-full h-full"
              src="/images/drive-box-logo-icon.svg"
              alt=""
            />
          </div>
          <h1 class="capitalize text-3xl font-medium flex-1">drive box</h1>
        </header>
        <main class="flex flex-col gap-5">
          <h2 class="text-2xl text-center">Welcome to drive box!</h2>

          <form
            class="flex flex-col gap-2 my-8 flex-1"
            data-validity="default"
            id="login"
            action="/login"
            method="post"
            novalidate
          >
            <span data-field-msg="form" class="text-sm text-red-600"></span>

            <div class="flex flex-col gap-8">
              <div class="flex flex-col gap-2">
                <span
                  data-field-msg="userIdentifier"
                  class="hidden text-red-600 text-sm"
                ></span>
                <div class="flex flex-col gap-2">
                  <label for="userIdentifier">Username or Email</label>
                  <input
                    type="text"
                    id="userIdentifier"
                    name="userIdentifier"
                    placeholder="Enter username or email"
                    autocomplete="username"
                    required
                    data-validity="default"
                    data-field-name="userIdentifier"
                    class="py-2 px-3 rounded-md border-gray-200 border focus:border-blue-400 outline-none data-[validity='valid']:border-green-400 data-[validity='invalid']:border-red-400 data-[validity='invalid']:placeholder:text-red-300"
                  />
                </div>
              </div>
              <div class="flex flex-col gap-2">
                <span
                  data-field-msg="password"
                  class="hidden text-red-600 text-sm"
                ></span>
                <div class="flex flex-col gap-2">
                  <label for="password">Password</label>
                  <input
                    required
                    placeholder="********"
                    autocomplete="current-password"
                    type="password"
                    name="password"
                    id="password"
                    data-validity="default"
                    data-field-name="password"
                    class="py-2 px-3 rounded-md border-gray-200 border focus:border-blue-400 outline-none data-[validity='valid']:border-green-400 data-[validity='invalid']:border-red-400 data-[validity='invalid']:placeholder:text-red-300"
                  />
                </div>
                <div>
                  <input
                    class="cursor-pointer"
                    type="checkbox"
                    name="toggle"
                    id="toggle"
                  />
                  <label for="toggle" class="select-none cursor-pointer"
                    >Show password</label
                  >
                </div>
              </div>
            </div>
            <button
              class="rounded-md py-2 px-4 border border-gray-400 font-medium w-fit mx-auto cursor-pointer hover:bg-gray-100"
              type="submit"
            >
              Log In
            </button>
          </form>

          <div>
            <span>New to drive box?</span>
            <a
              class="hover:no-underline underline text-blue-400 hover:font-medium"
              href="/register"
              >Create account</a
            >
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
