<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drive Box - Fast, Modern, and Secure Cloud Storage</title>
    <meta
      name="description"
      content="Store, organize, and access all your files and nested folders in one modern, secure cloud drive."
    />
    <link rel="stylesheet" href="/shared.css" />
  </head>
  <body
    class="bg-slate-50 text-slate-900 antialiased selection:bg-blue-600 selection:text-white flex flex-col min-h-screen"
  >
    <!-- TOP NAVIGATION -->
    <header
      class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/80 border-b border-slate-200/80 transition-all py-4 md:py-6"
    >
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between"
      >
        <!-- Logo -->
        <a
          href="/"
          class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-lg p-1"
        >
          <span
            class="size-10 md:size-12 transition-transform duration-200 group-hover:scale-105 flex"
          >
            <img
              src="/images/drive-box-logo-icon.svg"
              alt="Drive Box Logo"
              class="w-full h-full max-w-full max-h-full"
            />
          </span>
          <span class="text-xl font-bold tracking-tight text-slate-900">
            Drive <span class="text-blue-600">Box</span>
          </span>
        </a>

        <!-- Desktop Navigation Links -->
        <nav
          class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600"
        >
          <a href="#features" class="hover:text-blue-600 transition-colors"
            >Features</a
          >
          <a href="#stack" class="hover:text-blue-600 transition-colors"
            >Tech Stack</a
          >
          <a
            href="https://github.com/TonyFred-code/drive-box"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-blue-600 transition-colors flex items-center gap-1"
          >
            <span>GitHub</span>
            <svg
              class="size-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section
      class="relative overflow-hidden pt-12 pb-20 sm:pt-20 sm:pb-32 hero-mesh-glow"
    >
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
      >
        <!-- Main Headline -->
        <h1
          class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight hero-gradient-text max-w-4xl mx-auto leading-[1.15] mb-6"
        >
          All your files. Seamlessly organized in one box.
        </h1>

        <!-- Subtitle -->
        <p
          class="text-base sm:text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed"
        >
          Experience ultra-fast folder nesting, interactive breadcrumbs
          navigation, and robust session security engineered for pure speed and
          simplicity.
        </p>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12"
        >
          <% if (user) { %>
          <a
            href="/dashboard"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-lg shadow-blue-600/25 hover:shadow-xl hover:shadow-blue-600/35 transition-all text-base flex items-center justify-center gap-2"
          >
            <span>Open My Box</span>
            <svg
              class="size-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"
              />
            </svg>
          </a>
          <% } else { %>
          <a
            href="/register"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-lg shadow-blue-600/25 hover:shadow-xl hover:shadow-blue-600/35 transition-all text-base flex items-center justify-center gap-2"
          >
            <span>Create Free Account</span>
            <svg
              class="size-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"
              />
            </svg>
          </a>
          <a
            href="/login"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 shadow-xs hover:border-slate-400 transition-all text-base"
          >
            Sign In to Account
          </a>
          <% } %>
        </div>

        <!-- Trust Badges -->
        <div
          class="flex flex-wrap items-center justify-center gap-6 text-xs sm:text-sm text-slate-500 font-medium"
        >
          <div class="flex items-center gap-2">
            <svg
              class="size-4 text-emerald-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            <span>32MB Free Sandbox</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="size-4 text-emerald-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            <span>PostgreSQL Sessions</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="size-4 text-emerald-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            <span>Nested Directory Trees</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CORE FEATURES BENTO GRID -->
    <section
      id="features"
      class="py-20 sm:py-28 bg-white border-t border-slate-200"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2
            class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2"
          >
            Designed for Control
          </h2>
          <p
            class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight"
          >
            Everything you need in a modern personal drive
          </p>
        </div>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
        >
          <!-- Feature 1 -->
          <div
            class="bento-card-shine p-8 rounded-3xl bg-slate-50 border border-slate-200/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div
                class="size-12 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center mb-6"
              >
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                  />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">
                Arbitrary Folder Nesting
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                Create folders inside folders with recursive breadcrumb
                resolution. Clean parent-child relations keep your hierarchy
                structured without limits.
              </p>
            </div>
            <div
              class="mt-6 pt-4 border-t border-slate-200/60 flex items-center gap-2 text-xs font-semibold text-blue-600"
            >
              <span>Fast relational traversal</span>
            </div>
          </div>

          <!-- Feature 2 -->
          <div
            class="bento-card-shine p-8 rounded-3xl bg-slate-50 border border-slate-200/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div
                class="size-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center mb-6"
              >
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">
                Isolated User Sandboxes
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                Strict database-level ownership checks prevent unauthorized
                folder traversal. Your credentials are protected with salted
                bcrypt hashing and Postgres sessions.
              </p>
            </div>
            <div
              class="mt-6 pt-4 border-t border-slate-200/60 flex items-center gap-2 text-xs font-semibold text-emerald-600"
            >
              <span>Zero IDOR vulnerabilities</span>
            </div>
          </div>

          <!-- Feature 3 -->
          <div
            class="bento-card-shine p-8 rounded-3xl bg-slate-50 border border-slate-200/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div
                class="size-12 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center mb-6"
              >
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"
                  />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">
                Instant Granular Sorting
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                Sort folders dynamically by name, date modified, or date
                created. Dynamic direction labels adapt automatically whether
                you&apos;re sorting alphabetical or chronological.
              </p>
            </div>
            <div
              class="mt-6 pt-4 border-t border-slate-200/60 flex items-center gap-2 text-xs font-semibold text-purple-600"
            >
              <span>A-Z or chronological order</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TECH STACK SECTION -->
    <section id="stack" class="py-16 bg-slate-50 border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p
          class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-8"
        >
          Powered by a Modern, Production-Ready Stack
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6">
          <div
            class="px-4 py-2 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center gap-2"
          >
            <span class="size-2.5 rounded-full bg-emerald-500"></span>
            <span class="text-sm font-semibold text-slate-800"
              >Node.js ESM</span
            >
          </div>
          <div
            class="px-4 py-2 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center gap-2"
          >
            <span class="size-2.5 rounded-full bg-slate-900"></span>
            <span class="text-sm font-semibold text-slate-800">Express 5</span>
          </div>
          <div
            class="px-4 py-2 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center gap-2"
          >
            <span class="size-2.5 rounded-full bg-teal-500"></span>
            <span class="text-sm font-semibold text-slate-800"
              >Prisma 7 ORM</span
            >
          </div>
          <div
            class="px-4 py-2 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center gap-2"
          >
            <span class="size-2.5 rounded-full bg-blue-600"></span>
            <span class="text-sm font-semibold text-slate-800">PostgreSQL</span>
          </div>
          <div
            class="px-4 py-2 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center gap-2"
          >
            <span class="size-2.5 rounded-full bg-sky-400"></span>
            <span class="text-sm font-semibold text-slate-800"
              >Tailwind CSS v4</span
            >
          </div>
          <div
            class="px-4 py-2 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center gap-2"
          >
            <span class="size-2.5 rounded-full bg-amber-500"></span>
            <span class="text-sm font-semibold text-slate-800"
              >Passport.js Auth</span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- BOTTOM CTA BANNER -->
    <% if (!user)  { %>
    <section class="py-20 bg-slate-900 text-white relative overflow-hidden">
      <div
        class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
      >
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-6">
          Ready to experience cleaner cloud storage?
        </h2>
        <p class="text-slate-400 text-base sm:text-lg mb-8 max-w-xl mx-auto">
          Create your account in under 30 seconds. No card required, instant
          access to your root box.
        </p>
        <div
          class="flex flex-col *:max-w-xs sm:flex-row items-center justify-center gap-4"
        >
          <a
            href="/register"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-slate-900 bg-white hover:bg-slate-100 transition-colors shadow-lg shadow-white/10"
          >
            Create Free Account
          </a>
          <a
            href="/login"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors"
          >
            Log In
          </a>
        </div>
      </div>
    </section>
    <% } %>

    <!-- FOOTER -->
    <footer class="bg-white border-t border-slate-200 py-10 mt-auto">
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-slate-500"
      >
        <div class="flex items-center gap-2 font-semibold text-slate-800">
          <img src="/images/drive-box-logo-icon.svg" alt="" class="size-6" />
          <span>Drive Box</span>
        </div>
        <p>
          © 2026 Drive Box. Created with modern web technologies for The Odin
          Project.
        </p>
        <div class="flex items-center gap-4">
          <% if (!user) { %>
          <a href="/login" class="hover:text-blue-600 transition-colors"
            >Login</a
          >
          <a href="/register" class="hover:text-blue-600 transition-colors"
            >Register</a
          >
          <% } %>
          <a
            href="https://github.com/TonyFred-code/drive-box"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-blue-600 transition-colors"
          >
            GitHub
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
